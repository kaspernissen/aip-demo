# N11 (final-review.md): this file used to carry four variables this repo
# never reads anywhere (DASH0_MCP_TOKEN, DASH0_API_URL,
# OPENTELEMETRY_COLLECTOR_LOG_LEVEL, plus a stray "kagent, etc." comment
# inherited from the house dash0-examples template) alongside the ones
# scripts/setup-kind.sh actually sources. A cold reader filling this in
# could not tell which half mattered. Required vs. optional is now explicit
# below, verified against what setup-kind.sh actually checks/sources, not
# assumed from A2's variable-name table.

# Required now that M1.2 has shipped: settlement-agent's decision is a real
# Claude model call (agents/settlement-agent/settlement.py), not a stub.
# No script hard-fails on it being empty — secretKeyRef is deliberately
# `optional: true` so the cluster still comes up all 7 pods Running and
# fully traced without it (fix round, final-review.md SF-7) — but leaving it
# blank means the FIRST claim submission fails at the model call, which is
# the one thing this milestone exists to demonstrate. setup-kind.sh prints
# `ANTHROPIC_API_KEY: SET` or `... EMPTY — settlement-agent will fail on its
# first model call`; confirm SET before relying on this for a live demo.
ANTHROPIC_API_KEY=sk-ant-api03-your-api-key-here

# Required. The only variable setup-kind.sh hard-fails without
# (`: "${OPENTELEMETRY_COLLECTOR_CONTAINER_IMAGE:?...}"`); selects the
# collector image (A4).
OPENTELEMETRY_COLLECTOR_CONTAINER_IMAGE="otel/opentelemetry-collector-contrib:0.158.0"

# Optional. Presence alone enables the Dash0 exporter alongside Jaeger, with
# no other change (A3); absence is a fully supported, vendor-neutral default.
# DASH0_DATASET and the two DASH0_ENDPOINT_OTLP_GRPC_* values below are read
# only when DASH0_AUTH_TOKEN is set.
DASH0_AUTH_TOKEN="auth_abc123"
DASH0_DATASET="default"
DASH0_ENDPOINT_OTLP_GRPC_HOSTNAME="ingress.eu-west-1.aws.dash0.com"
DASH0_ENDPOINT_OTLP_GRPC_PORT="4317"