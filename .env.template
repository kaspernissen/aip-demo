# Only the variables scripts/setup-kind.sh actually checks or sources are
# listed below, each marked required or optional, so a reader filling this in
# can tell which ones matter.

# Required: settlement-agent's decision is a real Claude model call
# (agents/settlement-agent/settlement.py), not a stub. No script hard-fails on
# it being empty — secretKeyRef is deliberately `optional: true` so the
# cluster still comes up all 7 pods Running and fully traced without it — but
# leaving it blank means the first claim submission fails at the model call.
# setup-kind.sh prints `ANTHROPIC_API_KEY: SET` or `... EMPTY —
# settlement-agent will fail on its first model call`; confirm SET before
# relying on this for a live demo.
ANTHROPIC_API_KEY=sk-ant-api03-your-api-key-here

# Required. The only variable setup-kind.sh hard-fails without
# (`: "${OPENTELEMETRY_COLLECTOR_CONTAINER_IMAGE:?...}"`); selects the
# collector image.
OPENTELEMETRY_COLLECTOR_CONTAINER_IMAGE="otel/opentelemetry-collector-contrib:0.160.0"

# Optional. Presence alone enables the Dash0 exporter alongside Jaeger, with
# no other change; absence is a fully supported, vendor-neutral default.
# DASH0_DATASET and the two DASH0_ENDPOINT_OTLP_GRPC_* values below are read
# only when DASH0_AUTH_TOKEN is set.
DASH0_AUTH_TOKEN="auth_abc123"
DASH0_DATASET="default"
DASH0_ENDPOINT_OTLP_GRPC_HOSTNAME="ingress.eu-west-1.aws.dash0.com"
DASH0_ENDPOINT_OTLP_GRPC_PORT="4317"