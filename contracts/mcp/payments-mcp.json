{
  "server": "payments-mcp",
  "transport": "streamable-http",
  "endpoint": "http://payments-mcp.northstar-tools.svc.cluster.local:8000/mcp",
  "fronts": "payments-api",
  "tools": [
    {
      "name": "propose_payment",
      "description": "Propose a payment for a claim. Records an intent; moves no money.",
      "inputSchema": {
        "properties": {
          "claim_id": { "type": "string" },
          "amount": { "type": "number" },
          "currency": { "default": "EUR", "type": "string" }
        },
        "required": ["claim_id", "amount"],
        "type": "object",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "execute_payment",
      "description": "Execute a previously proposed payment.\n\nMoney leaves the company. This action cannot be undone.",
      "inputSchema": {
        "properties": {
          "payment_id": { "type": "string" }
        },
        "required": ["payment_id"],
        "type": "object",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false
      }
    }
  ]
}
