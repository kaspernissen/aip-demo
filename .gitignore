.env
.venv/
node_modules/
__pycache__/
*.pyc
.pytest_cache/
.next/
out/
next-env.d.ts
.superpowers/
# Staged into the build context by scripts/rebuild-and-deploy.sh; canonical copy
# lives in contracts/agent-cards/
agents/*/agent-card.json
# Generated from platform/policy-decision-service/proto/ext_mcp.proto by that
# service's ./gen-stubs.sh, at dev time and again at Docker build time (M2.2
# ruling R22). Committing them would let the image and the repo disagree about
# a contract whose source of truth is the vendored proto.
platform/policy-decision-service/ext_mcp_pb2.py
platform/policy-decision-service/ext_mcp_pb2_grpc.py
# macOS Finder metadata. Not ignored until 2026-09-16, which is why the
# Backstage image revision label -- derived from `git describe --dirty` by
# scripts/rebuild-and-deploy.sh -- had been reading `-dirty` on an otherwise
# clean tree, making every build look like it carried uncommitted work.
.DS_Store

# The talk deck (talk/): screenshots and fragment previews are regenerated by
# talk/build/shoot.py and build.py --only; only the sources are kept.
talk/export/
talk/preview-*
