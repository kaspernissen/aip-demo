.env
.venv/
node_modules/
__pycache__/
*.pyc
.pytest_cache/
.next/
out/
next-env.d.ts
.superpowers/
# Staged into the build context by scripts/rebuild-and-deploy.sh; canonical copy
# lives in contracts/agent-cards/
agents/*/agent-card.json
# Generated from platform/policy-decision-service/proto/ext_mcp.proto by that
# service's ./gen-stubs.sh, at dev time and again at Docker build time.
# Committing them would let the image and the repo disagree about a contract
# whose source of truth is the vendored proto.
platform/policy-decision-service/ext_mcp_pb2.py
platform/policy-decision-service/ext_mcp_pb2_grpc.py
# macOS Finder metadata. Left untracked so it can never make `git
# describe --dirty` label a clean tree as dirty -- scripts/rebuild-and-deploy.sh
# derives the Backstage image revision label from that command, so a stray
# .DS_Store would make every build look like it carried uncommitted work.
.DS_Store

# The talk deck (talk/): screenshots and fragment previews are regenerated by
# talk/build/shoot.py and build.py --only; only the sources are kept.
talk/export/
talk/preview-*

# The demo driver's run state (scripts/demo): this run's claim ids.
.demo/
